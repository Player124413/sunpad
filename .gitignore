# Local dependency checkouts (nested Git repos) and user-supplied disc images.
# Each checkout is a nested Git repository, so committing would create broken
# gitlinks or vendor bloat. The tree is reproducible from the pinned revisions
# in docs/DEPENDENCIES.md.
ref/
__pycache__/

# Local iOS provisioning (build products + host paths)
apple/ios/Provisioned/
