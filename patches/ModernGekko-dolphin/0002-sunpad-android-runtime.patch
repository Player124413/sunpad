 void VideoBackend::InitBackendInfo(const WindowSystemInfo& wsi)
 {
+#ifdef ANDROID
+  // A throwaway EGL window surface on the live ANativeWindow, then
+  // eglTerminate in the unique_ptr destructor, leaves Adreno unable to
+  // create the real EmuThread context. Probe headless (pbuffer / EGL
+  // default display) so the app window stays untouched.
+  WindowSystemInfo probe = wsi;
+  probe.type = WindowSystemType::Headless;
+  probe.render_surface = nullptr;
+  probe.render_window = nullptr;
+  std::unique_ptr<GLContext> temp_gl_context =
+      GLContext::Create(probe, g_Config.stereo_mode == StereoMode::QuadBuffer, true,
+                        Config::Get(Config::GFX_PREFER_GLES));
+#else
   std::unique_ptr<GLContext> temp_gl_context =
       GLContext::Create(wsi, g_Config.stereo_mode == StereoMode::QuadBuffer, true,
                         Config::Get(Config::GFX_PREFER_GLES));
+#endif
 
   if (!temp_gl_context)
     return;
