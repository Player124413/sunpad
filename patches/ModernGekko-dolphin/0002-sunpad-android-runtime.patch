diff --git a/Source/Core/Common/IDCacheStub.cpp b/Source/Core/Common/IDCacheStub.cpp
new file mode 100644
index 0000000..ddbbdaa
--- /dev/null
+++ b/Source/Core/Common/IDCacheStub.cpp
@@ -0,0 +1,56 @@
+// Copyright 2026 SunPad project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// Minimal IDCache replacement for SunPad Android.
+//
+// Upstream Dolphin implements IDCache in its Android app JNI layer
+// (Source/Android/jni/AndroidCommon/IDCache.cpp), which SunPad does not
+// build. A few core files still call into it on Android (GCAdapter is
+// stubbed separately, IOAndroid and the emulated Microphone query the
+// JavaVM / record-audio permission). SunPad's app registers the process
+// JavaVM from its own JNI_OnLoad (SunPadAndroidSetJavaVM), so
+// GetEnvForThread works; the permission helpers are no-ops because the
+// SunPad app requests permissions itself and never emulates a microphone.
+
+#include <jni.h>
+
+#include "jni/AndroidCommon/IDCache.h"
+
+JavaVM* g_sunpad_java_vm = nullptr;
+
+extern "C" void SunPadAndroidSetJavaVM(JavaVM* vm)
+{
+  g_sunpad_java_vm = vm;
+}
+
+namespace IDCache
+{
+JNIEnv* GetEnvForThread()
+{
+  if (g_sunpad_java_vm == nullptr)
+    return nullptr;
+  JNIEnv* env = nullptr;
+  if (g_sunpad_java_vm->GetEnv(reinterpret_cast<void**>(&env), JNI_VERSION_1_6) !=
+      JNI_OK)
+  {
+    if (g_sunpad_java_vm->AttachCurrentThread(&env, nullptr) != JNI_OK)
+      return nullptr;
+  }
+  return env;
+}
+
+jclass GetPermissionHandlerClass()
+{
+  return nullptr;
+}
+
+jmethodID GetPermissionHandlerHasRecordAudioPermission()
+{
+  return nullptr;
+}
+
+jmethodID GetPermissionHandlerRequestRecordAudioPermission()
+{
+  return nullptr;
+}
+}  // namespace IDCache
