@@ -167,7 +167,14 @@ private:
         continue;
       }
 
-      function(std::move(m_items.Front()));
+      try
+      {
+        if (function)
+          function(std::move(m_items.Front()));
+      }
+      catch (const std::exception&)
+      {
+      }
       m_items.Pop();
     }
   }
@@ -194,7 +201,18 @@ public:
 
   void Reset(std::string thread_name)
   {
-    m_worker.Reset(std::move(thread_name), std::invoke<FuncType>);
+    // Swallow bad_function_call: queued jobs often call another empty
+    // std::function. That must not abort the worker thread (SIGABRT).
+    m_worker.Reset(std::move(thread_name), [](FuncType func) {
+      try
+      {
+        if (func)
+          std::invoke(std::move(func));
+      }
+      catch (const std::exception&)
+      {
+      }
+    });
   }
 
   void Push(FuncType func) { m_worker.Push(std::move(func)); }
