diff --git a/Source/Core/DolphinNoGUI/PlatformAndroid.cpp b/Source/Core/DolphinNoGUI/PlatformAndroid.cpp
new file mode 100644
index 0000000..54087fb
--- /dev/null
+++ b/Source/Core/DolphinNoGUI/PlatformAndroid.cpp
@@ -0,0 +1,76 @@
+// Copyright 2026 SunPad project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// Android host platform for the ModernGekko runtime: hands the app-provided
+// ANativeWindow to the Vulkan (or OpenGL ES) video backend and pumps the
+// runtime without Dolphin's Android app/JNI frontend.
+
+#include "DolphinNoGUI/Platform.h"
+
+#include <chrono>
+#include <thread>
+
+#include "Core/Core.h"
+#include "Core/System.h"
+#include "VideoCommon/Present.h"
+
+namespace
+{
+void* g_render_surface = nullptr;
+}
+
+extern "C" void ModernGekkoSetAndroidRenderSurface(void* surface)
+{
+  g_render_surface = surface;
+  // While the video backend is up (surface recreated on rotation / app
+  // foreground), hand the new ANativeWindow to the presenter so the Vulkan
+  // swapchain is recreated instead of presenting into a stale window.
+  // Before the backend initializes, g_presenter is null and the handle is
+  // just stored for GetWindowSystemInfo(). A null surface is never routed
+  // to the presenter: the host pauses emulation around surface destruction
+  // and keeps the previous window reference until a replacement arrives.
+  // g_presenter lives in the global namespace (see VideoCommon/Present.h).
+  if (surface != nullptr && g_presenter)
+    g_presenter->ChangeSurface(surface);
+}
+
+namespace
+{
+class PlatformAndroid : public Platform
+{
+public:
+  ~PlatformAndroid() override = default;
+
+  bool Init() override { return true; }
+
+  void SetTitle(const std::string& /*title*/) override {}
+
+  void MainLoop() override
+  {
+    while (IsRunning())
+    {
+      UpdateRunningFlag();
+      Core::HostDispatchJobs(Core::System::GetInstance());
+      std::this_thread::sleep_for(std::chrono::milliseconds(8));
+    }
+  }
+
+  WindowSystemInfo GetWindowSystemInfo() const override
+  {
+    WindowSystemInfo wsi;
+    // Vulkan's Android WSI (vkCreateAndroidSurfaceKHR) consumes the
+    // ANativeWindow directly as the render surface; the OpenGL ES path uses
+    // the same handle through EGL (ANativeWindow-based surface).
+    wsi.type = WindowSystemType::Android;
+    wsi.display_connection = nullptr;
+    wsi.render_window = g_render_surface;
+    wsi.render_surface = g_render_surface;
+    return wsi;
+  }
+};
+}  // namespace
+
+std::unique_ptr<Platform> Platform::CreateAndroidPlatform()
+{
+  return std::make_unique<PlatformAndroid>();
+}
