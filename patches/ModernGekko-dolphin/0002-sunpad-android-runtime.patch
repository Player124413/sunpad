diff --git a/Source/Core/AudioCommon/OpenSLESStream.cpp b/Source/Core/AudioCommon/OpenSLESStream.cpp
index 28fe285..768863f 100644
--- a/Source/Core/AudioCommon/OpenSLESStream.cpp
+++ b/Source/Core/AudioCommon/OpenSLESStream.cpp
@@ -14,7 +14,17 @@
 #include "Common/CommonTypes.h"
 #include "Common/Logging/Log.h"
 #include "Core/Config/ConfigManager.h"
-#include "jni/AndroidCommon/IDCache.h"
+
+// SunPad Android audio: the app registers its JavaVM from the JNI_OnLoad of
+// its own native library, so this backend can query the native sample rate
+// and buffer size through the small com.sunpad.android.AudioUtils class.
+// Dolphin's app-side IDCache/JNI layer is not linked into the SunPad core.
+static JavaVM* s_sunpad_java_vm = nullptr;
+
+extern "C" void SunPadAndroidSetJavaVM(JavaVM* vm)
+{
+  s_sunpad_java_vm = vm;
+}
 
 void OpenSLESStream::BQPlayerCallback(SLAndroidSimpleBufferQueueItf bq, void* context)
 {
@@ -38,12 +48,43 @@ void OpenSLESStream::PushSamples(SLAndroidSimpleBufferQueueItf bq)
 
 bool OpenSLESStream::Init()
 {
-  JNIEnv* env = IDCache::GetEnvForThread();
-  jclass audio_utils = IDCache::GetAudioUtilsClass();
-  const SLuint32 sample_rate =
-      env->CallStaticIntMethod(audio_utils, IDCache::GetAudioUtilsGetSampleRate());
-  m_frames_per_buffer =
-      env->CallStaticIntMethod(audio_utils, IDCache::GetAudioUtilsGetFramesPerBuffer());
+  // Query the host audio properties through SunPad's AudioUtils class.
+  // Fall back to conservative defaults when the JavaVM was not registered or
+  // the class is missing, so the core can still boot (e.g. headless tooling).
+  SLuint32 sample_rate = 48000;
+  SLuint32 frames_per_buffer = 240;
+  if (s_sunpad_java_vm != nullptr)
+  {
+    JNIEnv* env = nullptr;
+    bool attached = false;
+    if (s_sunpad_java_vm->GetEnv(reinterpret_cast<void**>(&env), JNI_VERSION_1_6) !=
+        JNI_OK)
+    {
+      attached =
+          s_sunpad_java_vm->AttachCurrentThread(&env, nullptr) == JNI_OK;
+    }
+    if (env != nullptr)
+    {
+      jclass audio_utils = env->FindClass("com/sunpad/android/AudioUtils");
+      if (audio_utils != nullptr)
+      {
+        const jmethodID get_sample_rate =
+            env->GetStaticMethodID(audio_utils, "getSampleRate", "()I");
+        const jmethodID get_frames_per_buffer =
+            env->GetStaticMethodID(audio_utils, "getFramesPerBuffer", "()I");
+        if (get_sample_rate != nullptr)
+          sample_rate = static_cast<SLuint32>(
+              env->CallStaticIntMethod(audio_utils, get_sample_rate));
+        if (get_frames_per_buffer != nullptr)
+          frames_per_buffer = static_cast<SLuint32>(
+              env->CallStaticIntMethod(audio_utils, get_frames_per_buffer));
+        env->DeleteLocalRef(audio_utils);
+      }
+      if (attached)
+        s_sunpad_java_vm->DetachCurrentThread();
+    }
+  }
+  m_frames_per_buffer = frames_per_buffer;
 
   INFO_LOG_FMT(AUDIO, "OpenSLES configuration: {} Hz, {} frames per buffer", sample_rate,
                m_frames_per_buffer);
