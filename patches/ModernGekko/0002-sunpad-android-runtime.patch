-if(MODERNGEKKO_ENABLE_DOLPHIN_RUNTIME)
+if(MODERNGEKKO_ENABLE_DOLPHIN_RUNTIME AND
+   NOT CMAKE_SYSTEM_NAME STREQUAL "Android")
+    # The SDL3-based desktop frontend (moderngekko-run/launcher/port) is not
