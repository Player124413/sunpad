-    if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
+    if(CMAKE_SYSTEM_NAME STREQUAL "Android")
+        # SunPad's ANativeWindow platform for Android (Vulkan/OpenGL ES WSI)
+        target_sources(moderngekko PRIVATE
+            vendor/dolphin/Source/Core/DolphinNoGUI/PlatformAndroid.cpp)
+        target_compile_definitions(moderngekko PRIVATE MODERNGEKKO_HAVE_ANDROID=1)
+        target_link_libraries(moderngekko PRIVATE android log)
+    elseif(CMAKE_SYSTEM_NAME STREQUAL "iOS")
